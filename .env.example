# WhatsApp Cloud API (Meta Developer Dashboard > WhatsApp > API Setup)
ACCESS_TOKEN=your_whatsapp_access_token_here
PHONE_NUMBER_ID=your_whatsapp_number_id_here
VERIFY_TOKEN=your_secret_verify_token_here

# Meta App Secret (Meta Developer Dashboard > App Settings > Basic > App Secret).
# Used to verify the X-Hub-Signature-256 header on incoming webhooks.
APP_SECRET=your_meta_app_secret_here

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional admin WhatsApp number for human-handoff notifications and commands.
# Include the country code, no plus sign, e.g. 15551234567.
ADMIN_WHATSAPP_NUMBER=

# Optional tuning (defaults shown)
GEMINI_MODEL=gemini-3.5-flash-lite
HISTORY_LIMIT=10
GRAPH_API_VERSION=v24.0
PORT=5000
VALIDATE_SIGNATURE=true

# Optional overrides (leave commented to use the built-in text)
# SYSTEM_PROMPT=
# FALLBACK_MESSAGE=
# NON_TEXT_NOTICE=
